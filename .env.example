# Salin ke backend/.env sebelum menjalankan proyek. Jangan commit backend/.env.

# --- Opsi A: Supabase (dipakai saat ini) ---
# Ambil dari dashboard Supabase > Connect > ORMs > Prisma.
# Backend Express berjalan terus (bukan serverless), jadi aplikasi dan migrasi memakai session pooler (port 5432).
# Transaction pooler (6543, ?pgbouncer=true&connection_limit=1) hanya untuk deployment serverless.
# Host direct db.<ref>.supabase.co hanya IPv6; pakai pooler jika jaringan tidak mendukung IPv6.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=20&connect_timeout=30"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?connect_timeout=30"

# --- Opsi B: PostgreSQL lokal / docker-compose.yml (kredensial development, jangan dipakai di produksi) ---
# DATABASE_URL="postgresql://usahacerdas:usahacerdas_dev@localhost:5432/usahacerdas?schema=public"
# DIRECT_URL="postgresql://usahacerdas:usahacerdas_dev@localhost:5432/usahacerdas?schema=public"

JWT_SECRET="GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
