{
  "name": "usahacerdas",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c blue,green \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm test -w backend",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:studio": "npm run db:studio -w backend",
    "assistant": "node scripts/change-assistant.mjs",
    "change:request": "node scripts/change-assistant.mjs request",
    "change:log": "node scripts/change-assistant.mjs log",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:changelog": "node scripts/check-changelog.mjs"
  },
  "devDependencies": { "concurrently": "^9.1.2" },
  "engines": { "node": ">=20" }
}
